# The path the app fetches. Same-origin, so no CORS.
VITE_PAYLOAD_URL=/api/payload

# What /api/payload is proxied to: the dev server in development, nginx in the
# container. The bucket sends no CORS headers, so the browser cannot call it
# directly.
PAYLOAD_ORIGIN=https://example.s3.amazonaws.com
PAYLOAD_PATH=/path/to/payload.json
PAYLOAD_HOST=example.s3.amazonaws.com
